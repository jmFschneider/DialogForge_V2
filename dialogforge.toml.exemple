# Exemple de fichier de reglages DialogForge.
#
# Copier sous `dialogforge.toml` (dossier courant) ou
# `~/.dialogforge/reglages.toml`, ou le designer par `--config <chemin>`.
# Le premier trouve gagne ; les autres sont ignores, jamais fusionnes.
# Les anciens noms (`iabinome.toml`, `~/.iabinome.toml`) sont encore lus,
# en dernier recours, avec un message qui dit de les renommer.
#
# Precedence : drapeau de la ligne de commande > ce fichier > defaut du
# programme > defaut de l'adaptateur (pour les modeles).
#
# Ce fichier n'est lu qu'au `new`, plus `timeout` pour `run`, `resume` et
# `decide --correct` (la seule decision qui appelle les agents).
# Il ne touche jamais une collaboration deja creee : `configuration.json`
# y est la seule verite.
#
# Une cle inconnue est REFUSEE, pas ignoree. Toutes les cles sont
# facultatives.

# --- Qui tient quel role ---------------------------------------------
agent_a = "codex"
agent_b = "claude"

# --- Modeles ---------------------------------------------------------
# Sans ces lignes, chaque adaptateur applique son propre defaut par role.
# model_a = "opus"
# model_b = "sonnet"

# --- Effort de raisonnement (facultatif) -----------------------------
# Sans ces lignes, rien n'est demande a l'outil : Codex tourne alors a "none" sous
# --ignore-user-config (constate le 2026-09-19, decision du PO : on ne change rien).
# Valeurs acceptees, refusees avant tout appel si l'outil ne les connait pas :
#   Claude : low, medium, high, xhigh, max
#   Codex  : minimal, low, medium, high, xhigh
# effort_a = "medium"
# effort_b = "high"

# --- Agent de cadrage (seulement avec `new --cadrer-avec-agent`) -----
# L'outil doit savoir tenir une session persistante ; sinon, refus avant tout appel.
# agent_cadrage = "claude"
# model_cadrage = "opus"
# effort_cadrage = "medium"

# --- Acces web (facultatif, FERME par defaut) ------------------------
# Meme politique pour A et B, figee a `new`. Absent ou false : Claude n'a que Read, Grep, Glob
# et Codex recoit explicitement web_search=disabled. true : Claude recoit WebSearch et
# WebFetch, Codex web_search=live. Le profil context-only reste sans aucun outil.
# Ouvert, ce que contient le prompt peut sortir de la machine par une requete web.
# web_access = true

# --- Enveloppe du cycle ----------------------------------------------
# Nombre maximal de revisions. 0 = B critique une fois, et la version qu'il a
# examinee est livree telle quelle : il n'y a pas d'appel de finalisation.
max_revisions = 1

# Delai dur par appel, en secondes.
timeout = 600

# --- Defauts de mission ----------------------------------------------
# "recherche" ou "conception" : recherche -> conception -> developpement.
# Une recherche exige au moins une source : l'acces web, ou un corpus.
# Une conception exige un corpus, son dossier d'entree. Un corpus se
# declare sur la ligne de commande : aucun chemin ne se regle ici.
kind = "recherche"

# "consult" laisse a B les outils de sa CLI ; "context-only" les lui retire.
reviewer_access = "consult"
