# Exemple de fichier de configuration IAbinome.
#
# Copier sous `iabinome.toml` (dossier courant) ou `~/.iabinome.toml`,
# ou le designer par `--config <chemin>`. Le premier trouve gagne ;
# les autres sont ignores, jamais fusionnes.
#
# Precedence : drapeau de la ligne de commande > ce fichier > defaut du
# programme > defaut de l'adaptateur (pour les modeles).
#
# Ce fichier n'est lu qu'au `new`, plus `timeout` pour `run` et `resume`.
# Il ne touche jamais une collaboration deja creee : `configuration.json`
# y est la seule verite.
#
# Une cle inconnue est REFUSEE, pas ignoree. Toutes les cles sont
# facultatives.

# --- Qui tient quel role ---------------------------------------------
agent_a = "codex"
agent_b = "claude"

# --- Modeles ---------------------------------------------------------
# Sans ces lignes, chaque adaptateur applique son propre defaut par role.
# model_a = "opus"
# model_b = "sonnet"

# --- Effort de raisonnement (facultatif) -----------------------------
# Sans ces lignes, rien n'est demande a l'outil : Codex tourne alors a "none" sous
# --ignore-user-config (constate le 2026-09-19, decision du PO : on ne change rien).
# Valeurs acceptees, refusees avant tout appel si l'outil ne les connait pas :
#   Claude : low, medium, high, xhigh, max
#   Codex  : minimal, low, medium, high, xhigh
# effort_a = "medium"
# effort_b = "high"

# --- Acces web (facultatif, FERME par defaut) ------------------------
# Meme politique pour A et B, figee a `new`. Absent ou false : Claude n'a que Read, Grep, Glob
# et Codex recoit explicitement web_search=disabled. true : Claude recoit WebSearch et
# WebFetch, Codex web_search=live. Le profil context-only reste sans aucun outil.
# Ouvert, ce que contient le prompt peut sortir de la machine par une requete web.
# web_access = true

# --- Enveloppe du cycle ----------------------------------------------
# Nombre maximal de revisions. 0 = B critique une fois, A finalise.
max_revisions = 1

# Delai dur par appel, en secondes.
timeout = 600

# --- Defauts de mission ----------------------------------------------
# "conception" ou "recherche". Une mission de recherche exige un corpus,
# qui se declare sur la ligne de commande : aucun chemin ne se regle ici.
kind = "conception"

# "consult" laisse a B les outils de sa CLI ; "context-only" les lui retire.
reviewer_access = "consult"
